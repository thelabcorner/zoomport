{
  "name": "@zoomport/react",
  "version": "0.1.0",
  "description": "Headless React pan, zoom, and viewport primitives",
  "keywords": [
    "react",
    "zoom",
    "pan",
    "pinch",
    "svg",
    "canvas",
    "headless"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@zoomport/core": "0.1.0",
    "@zoomport/dom": "0.1.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelabcorner/zoomport.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/thelabcorner/zoomport#readme",
  "bugs": {
    "url": "https://github.com/thelabcorner/zoomport/issues"
  }
}
